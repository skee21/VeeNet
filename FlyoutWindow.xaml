<Window x:Class="VeeNet.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
        </Style>
    </Window.Resources>

    <Border Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Border CornerRadius="14"
                Background="#E8202020"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                Padding="18"
                Width="320">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True"
                            Width="64" Height="64" Background="#33FFFFFF">
                        <Image x:Name="AlbumArtImage"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Not Playing"
                                   Foreground="#F0FFFFFF"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="210"/>
                        <TextBlock x:Name="ArtistText"
                                   Text=""
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="210"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,2,0,0">
                    <Button Style="{StaticResource TransportButton}"
                            Content="&#xE892;"
                            Click="PrevButton_Click"
                            ToolTip="Previous"/>
                    <Button x:Name="PlayPauseBtn"
                            Style="{StaticResource PlayPauseButton}"
                            Content="&#xE768;"
                            Click="PlayPauseButton_Click"
                            ToolTip="Play / Pause"
                            Margin="12,0"/>
                    <Button Style="{StaticResource TransportButton}"
                            Content="&#xE893;"
                            Click="NextButton_Click"
                            ToolTip="Next"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
